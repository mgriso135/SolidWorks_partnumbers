# PartCode server reachable from the sandbox container.
# On the PartCode host, host.docker.internal maps to the host gateway.
PARTCODE_URL=http://host.docker.internal:7000

# Create this in PartCode under Users & API keys. Do not commit the real key.
PARTCODE_API_KEY=pk_live_replace_me

# Match these to the real PDM connector settings when you replace the sandbox.
PDM_VAULT=SandboxVault
DOCUMENT_TYPE=part
TARGET_VARIABLE=PartNumber

# Only for a test server with a self-signed HTTPS certificate.
PARTCODE_TLS_INSECURE=false

# The sandbox has no authentication. Keep 127.0.0.1 and use an SSH tunnel,
# or set 0.0.0.0 only on an isolated test LAN with a firewall rule.
SANDBOX_BIND=127.0.0.1
