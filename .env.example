# Copy to .env and adjust for your environment.
# The backend reads these variables when started with --env-file ../.env.

# Development default uses SQLite inside backend/.
DATABASE_URL=sqlite:///./partcode.db
# Production example:
# DATABASE_URL=postgresql+psycopg://partcode:change-me@localhost:5432/partcode

# Used by docker-compose.yml for the bundled PostgreSQL service.
POSTGRES_PASSWORD=partcode

# Replace with a long random value in production.
# Docker Compose refuses to start if this variable is missing.
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7000,http://127.0.0.1:7000,http://localhost:8000

# Set to false in production.
SEED_DEMO=true

# Create tables from SQLAlchemy models on startup (development only).
# Set to false in production and run `alembic upgrade head` instead.
AUTO_CREATE_TABLES=true
ENVIRONMENT=development

# ERP lookup/reconciliation is read-only. Keep "stub" until configured.
ERP_ADAPTER=stub

# File adapter: JSON or CSV snapshot readable inside the container.
# ERP_FILE_PATH=/data/erp-items.json

# REST adapter: GET {ERP_BASE_URL}{ERP_LOOKUP_PATH}; 404 means not found.
# ERP_BASE_URL=https://erp.example/api
# ERP_LOOKUP_PATH=/items/{code}
# ERP_API_KEY=replace_me
# ERP_API_KEY_HEADER=Authorization
# Prefix is literal; include the trailing space for bearer tokens.
# ERP_API_KEY_PREFIX="Bearer "
# ERP_TIMEOUT_SECONDS=10
